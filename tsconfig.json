{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "server",
    "shared",
    "client",
    "tests",
    "vite.config.ts",
    "launcher",
    "desktop",
    "playwright.desktop.config.ts"
  ]
}
