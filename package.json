{
  "name": "mars-comms",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-desktop.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:control:browser": "playwright test --config playwright.control.config.ts",
    "postinstall": "node scripts/install-electron.mjs",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "test:packaged": "node scripts/test-packaged.mjs",
    "test:portable": "node scripts/test-portable.mjs"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "pngjs": "^7.0.0"
  },
  "description": "Local production intercom with native desktop launcher",
  "author": "Mars Comms",
  "main": "desktop-dist/main.cjs"
}
